{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    // #ifdef H5
    {
      "path": "pages/web/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "总账"
      }
    }
    // #endif
  ],
  "subPackages": [
    // #ifdef H5
    {
      "root": "sub-web",
      "pages": [
        { "path": "people", "style": { "navigationStyle": "custom" } },
        { "path": "person", "style": { "navigationStyle": "custom" } },
        { "path": "books", "style": { "navigationStyle": "custom" } },
        { "path": "book", "style": { "navigationStyle": "custom" } },
        { "path": "recognize", "style": { "navigationStyle": "custom" } }
      ]
    }
    // #endif
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "人情往来账本",
    "navigationBarBackgroundColor": "#F6F2EC",
    "backgroundColor": "#F6F2EC",
    "backgroundTextStyle": "dark"
  }
}
